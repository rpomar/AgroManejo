@startuml arquitetura
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam componentStyle rectangle
skinparam rectangle {
  BackgroundColor #FBFCF8
  BorderColor #4A6B2A
}
left to right direction

node "Celular Android" {
  rectangle "Aplicativo AgroManejo\n(MIT App Inventor, componentes nativos)" as APP {
    rectangle "Telas e abas\n(Screen, arranjos, Map, Polygon, Marker)" as UI
    rectangle "Procedimentos em blocos\n(cálculo geográfico, regras, sincronização)" as SRV
    rectangle "Clock\n(sincronização periódica)" as CLK
    rectangle "Web\n(HTTPS + JSON)" as WEB
    database "TinyDB\n(dados da propriedade e sessão)" as DB
  }
  rectangle "GPS do aparelho\n(LocationSensor)" as GPS
}

cloud "Internet (quando disponível)" {
  rectangle "Supabase" as SUP {
    rectangle "Autenticação\n(/auth/v1)" as AUTH
    rectangle "API REST e funções\n(/rest/v1/rpc)" as API
    database "PostgreSQL + PostGIS" as PG
  }
  rectangle "Provedor de Mapas\n(imagens de satélite)" as MAP
}

UI --> SRV
CLK --> SRV
SRV --> DB
SRV --> GPS
SRV --> WEB
UI ..> MAP : imagens de fundo\n(componente Map)
WEB ..> AUTH : login, conta, senha
WEB ..> API : sincronização
API --> PG
@enduml
